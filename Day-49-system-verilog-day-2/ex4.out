#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56b3e6dfa500 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56b3e6dfa6b0 .scope module, "ex4" "ex4" 3 23;
 .timescale 0 0;
v0x56b3e6dfa840_0 .var/s "a", 7 0;
v0x56b3e6e44d80_0 .var "shifted_output", 7 0;
    .scope S_0x56b3e6dfa6b0;
T_0 ;
    %pushi/vec4 182, 0, 8;
    %store/vec4 v0x56b3e6dfa840_0, 0, 8;
    %vpi_call/w 3 31 "$display", "the original bits are: %b", v0x56b3e6dfa840_0 {0 0 0};
    %load/vec4 v0x56b3e6dfa840_0;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %shiftl 4;
    %store/vec4 v0x56b3e6e44d80_0, 0, 8;
    %vpi_call/w 3 34 "$display", "the left shifted by 2 value is: %b", v0x56b3e6e44d80_0 {0 0 0};
    %load/vec4 v0x56b3e6dfa840_0;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %shiftr 4;
    %store/vec4 v0x56b3e6e44d80_0, 0, 8;
    %vpi_call/w 3 37 "$display", "the right shifted by 2 value is: %b", v0x56b3e6e44d80_0 {0 0 0};
    %load/vec4 v0x56b3e6dfa840_0;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %shiftl 4;
    %store/vec4 v0x56b3e6e44d80_0, 0, 8;
    %vpi_call/w 3 40 "$display", "the arthmetic left shifted by 2 value is: %b", v0x56b3e6e44d80_0 {0 0 0};
    %load/vec4 v0x56b3e6dfa840_0;
    %ix/load 4, 2, 0;
    %flag_set/imm 4, 0;
    %shiftr/s 4;
    %store/vec4 v0x56b3e6e44d80_0, 0, 8;
    %vpi_call/w 3 43 "$display", "the arthmetic right shifted by 2 value is: %b", v0x56b3e6e44d80_0 {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "ex4.sv";
